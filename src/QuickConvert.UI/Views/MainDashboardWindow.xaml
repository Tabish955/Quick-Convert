<ui:FluentWindow x:Class="QuickConvert.UI.Views.MainDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:QuickConvert.UI.ViewModels"
        mc:Ignorable="d"
        Title="QuickConvert — Offline Convertio Dashboard"
        Height="640" Width="980"
        MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        d:DataContext="{d:DesignInstance vm:MainDashboardViewModel}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Output Directory Picker -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="QuickConvert Dashboard" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Offline, high-performance file conversion suite" FontSize="13" Foreground="#777777" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Destination Folder -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Save to: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox Text="{Binding OutputFolderPath, UpdateSourceTrigger=PropertyChanged}" Width="260" Height="34" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                <Button Content="Browse..." Command="{Binding BrowseOutputFolderCommand}" Height="34" Margin="0,0,6,0" Padding="10,0"/>
                <Button Content="📁 Open" Command="{Binding OpenOutputFolderCommand}" Height="34" Padding="10,0"/>
            </StackPanel>
        </Grid>

        <!-- Action Toolbar -->
        <Border Grid.Row="1" Background="#0C888888" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="➕ Add Files"
                        Command="{Binding AddFilesCommand}"
                        Height="36"
                        Padding="14,0"
                        FontWeight="SemiBold"
                        Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Batch Target: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding AvailableGlobalFormats}"
                              SelectedItem="{Binding SelectedGlobalFormat}"
                              Width="140"
                              Height="34">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource TargetFormatDisplayConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Quality: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <Slider Minimum="10" Maximum="100" Value="{Binding Quality}" Width="90" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Quality, StringFormat=' {0}%'}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="Clear Completed"
                            Command="{Binding ClearCompletedCommand}"
                            Height="36"
                            Padding="12,0"
                            Margin="0,0,8,0"/>

                    <Button Content="Cancel All"
                            Command="{Binding CancelAllCommand}"
                            IsEnabled="{Binding IsConverting}"
                            Height="36"
                            Padding="12,0"
                            Margin="0,0,8,0"/>

                    <Button Content="▶ Start Queue"
                            Command="{Binding StartQueueCommand}"
                            IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBoolConverter}}"
                            Height="36"
                            Padding="18,0"
                            FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Batch Queue DataGrid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Jobs}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="#20888888"
                  RowHeight="38"
                  FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Size" Binding="{Binding FormattedFileSize}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Target" Binding="{Binding TargetExtension, Converter={StaticResource TargetFormatDisplayConverter}}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="130" IsReadOnly="True"/>

                <DataGridTemplateColumn Header="Progress" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="4,0">
                                <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="10"/>
                                <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:0}%'}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Actions" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="📂"
                                        ToolTip="Reveal in File Explorer"
                                        Command="{Binding DataContext.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Width="28" Height="26"
                                        Margin="0,0,4,0"/>
                                <Button Content="✕"
                                        ToolTip="Cancel Job"
                                        Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Width="28" Height="26"
                                        Margin="0,0,4,0"/>
                                <Button Content="🗑"
                                        ToolTip="Remove from queue"
                                        Command="{Binding DataContext.RemoveJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Width="28" Height="26"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom Status & Overall Progress -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalJobsCount, StringFormat='Total: {0}'}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding ActiveJobsCount, StringFormat='Active: {0}'}" Foreground="#107C41" FontWeight="SemiBold" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding CompletedJobsCount, StringFormat='Completed: {0}'}" Foreground="#0078D4" FontWeight="SemiBold"/>
            </StackPanel>

            <ProgressBar Grid.Column="1"
                         Value="{Binding OverallProgress}"
                         Maximum="100"
                         Height="12"
                         Margin="20,0"/>

            <TextBlock Grid.Column="2"
                       Text="{Binding OverallProgress, StringFormat='Overall: {0:0}%'}"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
