# =============================================================================
# Quick-Convert — .gitignore
#
# Tracked:   source, project/solution files, build scripts, docs, config templates.
# Ignored:   anything a tool generates (build output, caches, test results,
#            downloaded CLI binaries, logs, installers, secrets).
#
# Rule of thumb: if you didn't type it by hand, it doesn't belong in Git.
# =============================================================================

# -----------------------------------------------------------------------------
# .NET build output
# -----------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
out/
artifacts/
publish/
*.deps.json
*.runtimeconfig.json
*.pdb
*.cache
*.tlog
*.binlog

# -----------------------------------------------------------------------------
# NuGet
# -----------------------------------------------------------------------------
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.assets.json
*.nuget.props
*.nuget.targets
.nuget/

# -----------------------------------------------------------------------------
# Tests, coverage and benchmarks
# -----------------------------------------------------------------------------
[Tt]est[Rr]esult*/
TestResults/
*.trx
*.coverage
*.coveragexml
coverage*.xml
coverage*.json
coverage*.info
*.received.*
BenchmarkDotNet.Artifacts/

# -----------------------------------------------------------------------------
# Local CLI tools — fetched by tools/fetch-tools.ps1, never committed
# (see tools/README.md; FFmpeg alone is >100 MB)
# -----------------------------------------------------------------------------
tools/ffmpeg/**
tools/7z/**
tools/pandoc/**
tools/wkhtmltopdf/**
!tools/ffmpeg/.gitkeep
!tools/7z/.gitkeep
!tools/pandoc/.gitkeep
!tools/wkhtmltopdf/.gitkeep
tools/_downloads/

# -----------------------------------------------------------------------------
# Installer / packaging output (Inno Setup, MSIX)
# -----------------------------------------------------------------------------
installer/Output/
installer/*.exe
*.msi
*.msix
*.msixbundle
*.msixupload
*.appx
*.appxbundle
*.appxupload
*.cab

# -----------------------------------------------------------------------------
# Visual Studio / VS Code / Rider / ReSharper
# -----------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.userprefs
*.sln.docstates
*.sln.DotSettings.user
*.DotSettings.user
_ReSharper*/
*.VC.db
*.VC.opendb
*.psess
*.vsp
*.vspx
code.lock

# -----------------------------------------------------------------------------
# Logs, crash dumps and diagnostics
# -----------------------------------------------------------------------------
*.log
logs/
*.etl
*.dmp
*.mdmp
crash-*.txt

# -----------------------------------------------------------------------------
# Secrets and signing material — never commit these
# -----------------------------------------------------------------------------
.env
.env.*
*.pfx
*.p12
*.snk
*.cer
*.key
secrets.json
appsettings.*.local.json

# -----------------------------------------------------------------------------
# Temp / scratch files
# -----------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*~
~$*
*.stackdump
scratch/
*.scratch.*
.tmp-extract-*/
.tmp_*/

# -----------------------------------------------------------------------------
# OS junk
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.Spotlight-V100
.Trashes

# -----------------------------------------------------------------------------
# Local hand-off scratch (screenshots, exported chat messages)
# -----------------------------------------------------------------------------
*WHATSAPP*
*whatsapp*

